# ==============================================================================
# UrjaSetu 2.0 — Environment Configuration Template
# ==============================================================================
# COPY this file to .env.local and fill in your actual project values.
# NEVER commit .env.local or real secrets to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Firebase Client SDK (Public Web App Config)
# Accessible on both client browser and server.
# Find these in Firebase Console: Project Settings -> General -> Your apps
# ------------------------------------------------------------------------------
NEXT_PUBLIC_FIREBASE_API_KEY="AIzaSyYourProjectApiKeyPlaceholder"
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN="urjasetu-prod.firebaseapp.com"
NEXT_PUBLIC_FIREBASE_PROJECT_ID="urjasetu-prod"
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET="urjasetu-prod.firebasestorage.app"
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID="123456789012"
NEXT_PUBLIC_FIREBASE_APP_ID="1:123456789012:web:abcdef1234567890"

# ------------------------------------------------------------------------------
# 2. Firebase Admin SDK (Server-Side Only — NEVER prefix with NEXT_PUBLIC_)
# Obtain from Firebase Console: Project Settings -> Service accounts -> Generate new private key
# ------------------------------------------------------------------------------
FIREBASE_PROJECT_ID="urjasetu-prod"
FIREBASE_CLIENT_EMAIL="firebase-adminsdk-xxxxx@urjasetu-prod.iam.gserviceaccount.com"
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwgg...\n-----END PRIVATE KEY-----\n"
FIREBASE_STORAGE_BUCKET="urjasetu-prod.firebasestorage.app"

# ------------------------------------------------------------------------------
# 3. Super Admin Initial Bootstrap (Local Provisioning Only)
# Used exclusively by the local provisioning script:
#   npm run bootstrap:super-admin
# ------------------------------------------------------------------------------
INITIAL_SUPER_ADMIN_EMAIL="director.swaminathan@urjasetu.gov.in"
INITIAL_SUPER_ADMIN_NAME="Dr. Aruna Swaminathan"
INITIAL_SUPER_ADMIN_STAFF_ID="SUP-001"
